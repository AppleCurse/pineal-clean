# PINEAL-HERETIC — ortam degiskenleri (bu dosyayi .env olarak kopyalayip doldurun)

# --- LLM (OpenRouter) ---
# Anahtar yoksa pipeline ilk LLM'li ajanda durur (tasarim geregi; halusinasyon onleme).
OPENROUTER_API_KEY=

# --- Model secimi (P2 ekonomik varsayilanlar; env ile ezilebilir) ---
OPENROUTER_TIER_1_MODEL=upstage/solar-pro4
OPENROUTER_TIER_2_MODEL=inclusionai/ling-3.0-flash
# 0 = sınırsız. >0 ise toplam tahmini USD bu eşiğe ulaşınca SpendCapExceeded.
# ÖNEMLİ: 0 = sınırsız harcama. Production'da mutlaka bilinçli bir değer girin.
# Örnek: OPENROUTER_MAX_SPEND_USD=5.00  → oturum başına max $5 harcama limiti.
# Aşılırsa SpendCapExceeded fırlatılır ve yeni LLM çağrıları reddedilir.
# Production'da bu değer sıfır bırakılırsa /health "SPEND_CAP_UNLIMITED" uyarısı taşır.
OPENROUTER_MAX_SPEND_USD=0
# OpenAI-uyumlu gateway ve tek istek timeout'u (gateway retry siniri 3'tur).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_REQUEST_TIMEOUT_SECONDS=45

# Guvenlik kapisi: 1 degilken dis LLM cagrileri kod tarafindan reddedilir.
# Canli LLM kullanmak icin: anahtar girin ve asagiyi 1 yapin.
LIVE_LLM_E2E=0

# --- Yerel LLM (opsiyonel: Ollama / LM Studio) ---
# Not: API sunucusunda Kasa (Vault) "yerel model" seçimi bu değeri ezer;
# env varsayılanı yalnız Kasa'dan use_local seçilmemişse kullanılır.
USE_LOCAL_LLM=false
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=dolphin-llama3:latest

# --- Native LLM yönlendirici ---
# PINEAL_LLM_BACKEND=unified -> /v1/chat/completions UnifiedRouter üzerinden çalışır
#   (varsayılan). Config dosyası yoksa katalog + env anahtarlarından otomatik
#   runtime kurulur (OpenRouter her zaman; Ollama USE_LOCAL_LLM=true ise;
#   Groq/DeepSeek/Cerebras/Mistral yalnız ilgili env anahtarı doluysa).
# PINEAL_LLM_BACKEND=legacy  -> mevcut tek-sağlayıcı gateway yolu.
# DİKKAT: unified seçilip otomatik/config runtime kurulamazsa startup ÇÖKMEZ;
# fail-safe olarak legacy yola düşer ve /health "UNIFIED_ROUTER_CONFIG_MISSING"
# nedeniyle DEGRADED döner.
PINEAL_LLM_BACKEND=unified
# İsteğe bağlı dosya override: config/router.example.json. Boş bırakılırsa
# katalogdan otomatik config kullanılır. Dosyadaki credential_env ile
# işaret edilen anahtarlar (örn. OPENROUTER_API_KEY) ayrıca tanımlanmalıdır.
PINEAL_ROUTER_CONFIG=

# --- Arama (AutonomousVerifier; Tavily / SerpAPI / Exa) ---
TAVILY_API_KEY=
SERPAPI_API_KEY=
EXA_API_KEY=

# --- Guvenlik (FAZ 8) ---
# development: token bos olabilir; /health bunu DISABLED_DEVELOPMENT_ONLY diye bildirir.
# production: token ZORUNLUDUR, yoksa servis startup'ta fail-closed durur.
PINEAL_ENV=development
PINEAL_REQUIRE_AUTH=false
# Tanimlanirsa tum /api/* X-API-Key ister. WS anahtari URL'ye degil ilk mesaja yazilir.
PINEAL_TOKEN=
# UI, PINEAL_TOKEN'i iki yoldan bilir: (1) calisma zamaninda Kasa panelinden girilir
# (localStorage, onerilen), (2) derleme zamaninda VITE_PINEAL_TOKEN gomulur (Docker build arg).
# Docker'da PINEAL_TOKEN set ettiyseniz VITE_PINEAL_TOKEN'i de ayni degere ayarlayin.
VITE_PINEAL_TOKEN=
# Disaridan erisime izin verilecek originler (virgulle, bos ise localhost kumesi)
PINEAL_ALLOWED_ORIGINS=

# --- Vision (FAZ 3) ---
# Gorselli isteklerde kullanilacak OpenRouter modeli
OPENROUTER_VISION_MODEL=google/gemini-3.7-flash

# --- Cache / Hafiza (opsiyonel) ---
# LLM yanit onbellegi (1=acik, 0=kapali); varsayilan acik
PINEAL_RESPONSE_CACHE=1
# Bellek motoru: canonical (varsayilan) | hindsight (anlamsal arama, sentence-transformers gerekir)
PINEAL_MEMORY_ENGINE=canonical

# --- OSINT entegrasyonlari (FAZ 1-5; hepsi DENEYSEL, default KAPALI) ---
# Her kapisi acmak yeni ag cagrilari acar; kapaliyken pipeline davranisi degismez.
ENABLE_MAIGRET=false            # kullanici-adi varlik taramasi (POST /api/experimental/maigret/scan)
MAIGRET_SITES_LIMIT=100         # 1..500
MAIGRET_TIMEOUT=15              # s/site (max 60)
MAIGRET_TOTAL_TIMEOUT=45        # s (max 180)
ENABLE_HOLEHE=false             # e-posta kayit taramasi (POST /api/experimental/holehe/scan)
HOLEHE_MODULES_LIMIT=100        # 1..300 (deterministik isim-sirali ilk N)
HOLEHE_TIMEOUT=10               # s (max 60)
HOLEHE_TOTAL_TIMEOUT=120        # s (max 600)
HOLEHE_CONCURRENCY=20           # eszamanli modul (max 50)
ENABLE_CRAWL4AI=false           # sayfa -> LLM-dostu metin (POST /api/experimental/crawl/fetch)
CRAWL4AI_RENDERER=http          # http (binary gerektirmez) | browser (Playwright; binary yoksa browser_missing)
CRAWL4AI_MAX_CHARS=8000         # metin kirpma (max 50000)
CRAWL4AI_TIMEOUT=20             # s (max 120)
CRAWL4AI_RESEARCH_LIMIT=2       # public-web arastirmada kac sonuca crawl (max 5)
# Kurulum notu: crawl4ai psutil>=6.1.1, open-interpreter psutil<6.0.0 BEYAN eder;
# ikinci adim dosyasiyla kurulur:
#   pip install -r requirements.txt && pip install -r requirements-osint.txt

# --- Stealth saglayici secici (FAZ 5; kapı degil secim) ---
# playwright_stealth (default, bugunku davranis) | invisible | cloak | none
STEALTH_PROVIDER=playwright_stealth
# invisible/cloak binary INDIRMEZ; operator gosterirse available olur:
INVISIBLE_BROWSER_BINARY=       # patched Firefox yolu (opsiyonel)
CLOAK_BROWSER_EXECUTABLE=       # CloakBrowser Chromium yolu (opsiyonel)

# --- Diger kullanilan ama orneklenmemis degiskenler ---
OSINT_INDUSTRIES_KEY=           # doluysa osint_investigator gercek API'yi kullanir; bossa durust fallback
ENABLE_INTERPRETER=false        # interpreter ajanini etkinlestirir
ALLOW_LOCAL_TO_CLOUD_FALLBACK=  # bos bos; yerel-LLM yoksa buluta dusme izni (false: dusmez)
SERPAPI_KEY=                    # arama saglayici (SERPAPI_API_KEY'a alternatif okuma adi)

# --- Docker build (build-time; runtime'i etkilemez) ---
# Chromium indirmesi (cdn.playwright.dev) bolgenizde engelliyse/yavamsa ayna.
# Dockerfile 3 kez dener + 300 sn baglanti t/o kullanir; bu degisken ek ayna saglar.
# Ornek: PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright
PLAYWRIGHT_DOWNLOAD_HOST=
