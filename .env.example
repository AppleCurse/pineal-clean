# PINEAL-HERETIC — ortam degiskenleri (bu dosyayi .env olarak kopyalayip doldurun)

# --- LLM (OpenRouter) ---
# Anahtar yoksa pipeline ilk LLM'li ajanda durur (tasarim geregi; halusinasyon onleme).
OPENROUTER_API_KEY=

# Guvenlik kapisi: 1 degilken dis LLM cagrileri kod tarafindan reddedilir.
# Canli LLM kullanmak icin: anahtar girin ve asagiyi 1 yapin.
LIVE_LLM_E2E=0

# --- Yerel LLM (opsiyonel: Ollama / LM Studio) ---
USE_LOCAL_LLM=false
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=dolphin-llama3:latest

# --- Arama (AutonomousVerifier; Tavily) ---
TAVILY_API_KEY=

# --- Guvenlik (FAZ 3) ---
# Bos birakilirsa sistem acik kipte calisir (yerel tek kullanicili arac).
# Tanimlanirsa tum /api/* X-API-Key ister; WS icin ?token=... gerekir.
PINEAL_TOKEN=
# Disaridan erisime izin verilecek originler (virgulle, bos ise localhost kumesi)
PINEAL_ALLOWED_ORIGINS=

# --- Vision (FAZ 3) ---
# Gorselli isteklerde kullanilacak OpenRouter modeli
OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-90b-vision-instruct
