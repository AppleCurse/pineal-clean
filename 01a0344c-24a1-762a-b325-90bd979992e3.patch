index 0000000..194564e
--- /dev/null
+++ b/.venv-forensics/lib/python3.11/site-packages/pip/_vendor/rich/_stack.py
@@ -0,0 +1,16 @@
+from typing import List, TypeVar
+
+T = TypeVar("T")
+
+
+class Stack(List[T]):
+    """A small shim over builtin list."""
+
+    @property
+    def top(self) -> T:
+        """Get top of stack."""
+        return self[-1]
+
+    def push(self, item: T) -> None:
+        """Push an item on to the stack (append in stack nomenclature)."""
+        self.append(item)
diff --git a/.venv-forensics/lib/python3.11/site-packages/pip/_vendor/rich/_timer.py b/.venv-forensics/lib/python3.11/site-packages/pip/_vendor/rich/_timer.py
